rules_version = '2';
// Yura 預約系統｜Firestore 安全規則
// 使用方式：Firebase 主控台 → Firestore Database → 規則 → 整個貼上 → 發布
// ⚠️ 把下面的 yura@example.com 換成你自己的後台登入 Email
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['yura@example.com'];
    }
    function maxLen(v, n) { return v is string && v.size() <= n; }

    // 時段設定（每週固定時段、公休、加開、封鎖）：大家都能讀，只有你能改
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 已被預約的時段（只有日期和時間，沒有客人資料）
    // 客人只能「新增」：同一個時段已經有人，就會被拒絕 → 不會撞期
    match /taken/{id} {
      allow read: if true;
      allow create: if isAdmin() || (
        id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}:[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['date', 'time', 'createdAt'])
        && id == request.resource.data.date + '_' + request.resource.data.time
      );
      allow update, delete: if isAdmin();
    }

    // 預約：只有你能看、能改；客人只能從網站送出一筆「待確認」的預約
    match /bookings/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.status == 'pending'
        && request.resource.data.web == true
        && request.resource.data.id == id
        && request.resource.data.keys().hasOnly(['id', 'web', 'status', 'createdAt', 'updatedAt', 'customerName', 'contact', 'pet',
             'service', 'source', 'channel', 'method', 'ext', 'date', 'time', 'takenKey', 'total', 'deposit', 'depositPaid',
             'balancePaid', 'paidAt', 'note'])
        && maxLen(request.resource.data.customerName, 100) && maxLen(request.resource.data.pet, 200)
        && maxLen(request.resource.data['service'], 140) && maxLen(request.resource.data.note, 6000)
        && maxLen(request.resource.data.date, 10) && maxLen(request.resource.data.time, 10)
        && request.resource.data.total == null && request.resource.data.depositPaid == false && request.resource.data.balancePaid == false
        && (!('takenKey' in request.resource.data)
            || existsAfter(/databases/$(database)/documents/taken/$(request.resource.data.takenKey)))
      );
    }

    // 客人資料、似顏繪排程：只有你
    match /customers/{id} { allow read, write: if isAdmin(); }
    match /arts/{id} { allow read, write: if isAdmin(); }
    match /photos/{id} { allow read, write: if isAdmin(); }
    match /lineUsers/{id} { allow read, write: if isAdmin(); }
    match /lineMessages/{id} { allow read, write: if isAdmin(); }
    // 客人填的匯款資料（匯款人、帳號後五碼），只能新增一次，只有你看得到
    match /payments/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['bookingId', 'payer', 'last5', 'amount', 'createdAt'])
        && request.resource.data.bookingId == id
        && request.resource.data.last5.matches('^[0-9]{5}$')
        && maxLen(request.resource.data.payer, 50)
        && exists(/databases/$(database)/documents/bookings/$(id));
    }
  }
}
